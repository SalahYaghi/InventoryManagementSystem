{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Information"
    } 
    
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
//    "DefaultConnection": "Server=.\\MSSQLSERVER_0009;User=sa;Password=sa123456;TrustServerCertificate=true;Database=InventoryManagementSystem"
        "DefaultConnection": "Server=sqlserver,1433;User=sa;Password=Your_strong_password123!;TrustServerCertificate=true;Database=InventoryManagementSystem"
  },
  "JwtSettings": {
    "TokenExpirationInMinutes": 15,
    "Audience": "inventorymanagementsystemapi",
    "Issuer": "inventorymanagementsystemapi",
    "Secret": "96461dde37850c762273043f6927cb14fa9dc424fb35ceae63e494da6cce27ff",
    "RefreshTokenExpirationInDays": 7
  },
  "Caching": {
    "DefaultCacheExpirationMinutes": 10,
    "DefaultLocalCacheExpirationMinutes": 2,
    "MaximumPayloadBytes": 5242880,
    "MaximumKeyLength": 1024,
    "Redis": {
      "ConnectionString": "redis:6379",
      "InstanceName": "inventory management system api",
      "ConnectTimeout": 1000,
      "AsyncTimeout": 300,
      "SyncTimeout": 300,
      "ConnectRetry": 3,
      "AbortOnConnectFail": false

    },
    "OutputCache": {
      "DefaultCacheExpirationSeconds": 60,
      "MaxbodySize": 62914560,
      "MaxCacheSize": 104857600

    }
  },
  "AppSettings": {
    "OpenAt": "02:00:00",
    "CloseAt": "24:00:00",
    "OrderingCancellationThresholdMinutes": 1,
    "RefreshTokenRevokerFrequentCheckInMinutes": 1,
    "OrderingCancellationFrequecyCheckInMinutes": 1,
    "RedisConnectionHealthCheckMinutes":  1
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 10,
      "AutoReplenishment": true
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowInMinutes": 1,
      "QueueLimit": 0
    }
  },
  "Otlp": {
    "Endpoint": "http://seq:5341/ingest/otlp/v1/traces"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Serilog.Sinks.Seq": "Information"
      }
    },

    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        } 
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "InventoryManagementSystemAPI"
    }
  }
  }
